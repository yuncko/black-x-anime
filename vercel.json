{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/search-anime",
      "destination": "/api/index.js"
    },
    {
      "source": "/get-episodes",
      "destination": "/api/index.js"
    },
    {
      "source": "/get-episode-dl",
      "destination": "/api/index.js"
    },
    {
      "source": "/latest-episodes",
      "destination": "/api/index.js"
    },
    {
      "source": "/fetch-seasonals",
      "destination": "/api/index.js"
    },
    {
      "source": "/get-anime-info",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.png|blackx-logo\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
